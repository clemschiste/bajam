FROM rust:1.100.0 AS builder

WORKDIR /app

# Workspace
COPY Cargo.toml Cargo.lock ./
COPY .sqlx .sqlx

# Crates
COPY bajam-common ./bajam-common
COPY bajam-cli ./bajam-cli
COPY bajam-daemon ./bajam-daemon

ENV SQLX_OFFLINE=true

# On travaille depuis le daemon
WORKDIR /app/bajam-daemon

RUN cargo build --release --bin setup
RUN cargo build --release --bin bajam-daemon

# --- Runtime ---
FROM debian:bookworm-slim

WORKDIR /app

COPY --from=builder /app/target/release/setup /app/setup
COPY --from=builder /app/target/release/bajam-daemon /app/bajam-daemon

COPY bajam-daemon/static ./static

RUN chmod +x /app/bajam-daemon/entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/app/entrypoint.sh"]

